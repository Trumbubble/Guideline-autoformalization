# LOINC is licensed -- load it locally, never redistribute it.
Loinc_*/
CQL_converter/loinc.db
CQL_converter/demo.db
patient_checker/engine/node_modules/
patient_checker/engine/*.jar
patient_checker/engine/cs
patient_checker/engine/classes/
patient_checker/engine/cp.txt
patient_checker/engine/*.json
!patient_checker/engine/package.json
# toolchain.cql_to_elm compiles by writing the CQL to a temp file HERE, not in
# /tmp -- the translator resolves `include FHIRHelpers` by looking for a
# sibling file. It unlinks it in a finally block, which does not run when the
# process dies abnormally (a segfault, a kill), so the odd tmp*.cql survives.
patient_checker/engine/tmp*.cql

# Uploaded guidelines are runtime data, not source.
patient_checker/guidelines/

# Licensed terminology releases -- load locally, never redistribute.
SnomedCT_*/
RxNorm_*/
CQL_converter/terms.db

# Semantic index: ~1 GB of float32 vectors, rebuildable in minutes from
# terms.db. Derived data, never source.
CQL_converter/semantic/
*.npy
paper.zip
.DS_Store
Formatting_Instructions_For_NeurIPS_2026/

# ablation output
patient_checker/tests/ablation.csv
# real-rule results are not reported; the --existing flag still produces them
patient_checker/tests/generated_ablation.csv
patient_checker/tests/explanation_*.csv
# summaries ARE tracked: small, and they are what the paper quotes
!patient_checker/tests/*.summary.txt
patient_checker/tests/may_actionability.csv

