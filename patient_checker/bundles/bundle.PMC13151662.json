 "rules": [
  {
   "rule_id": "PMC13151662:0000",
   "when": {
    "kind": "cmp",
    "var": "has_stroke",
    "op": "==",
    "value": true
   },
   "then": {
    "kind": "cmp",
    "var": "on_bp_lowering",
    "op": "==",
    "value": false
   },
   "action": "avoid",
   "target": "routine pre-hospital BP lowering",
   "strength": "moderate-certainty evidence",
   "deontic": "obligation",
   "source_page": null,
   "source_span": "We advise against routine pre-hospital BP lowering in suspected stroke (moderate-certainty evidence)."
  },
  {
   "rule_id": "PMC13151662:0002",
   "when": {
    "kind": "cmp",
    "var": "mechanical_thrombectomy",
    "op": "==",
    "value": true
   },
   "then": {
    "kind": "cmp",
    "var": "lowering_systolic_bp",
    "op": "==",
    "value": false
   },
   "action": "avoid",
   "target": "intensive lowering of systolic BP < 140 mmHg in the first 24 h after successful mechanical thrombectomy",
   "strength": "strong recommendation against; high-certainty evidence",
   "deontic": "obligation",
   "source_page": null,
   "source_span": "We recommend against intensively lowering systolic BP < 140 mmHg in the first 24 h after successful mechanical thrombectomy (high-certainty evidence)."
  }
 ],
