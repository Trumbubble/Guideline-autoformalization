  {
   "rule_id": "ais-reperfusion-bp-targets",
   "reason_code": "unsupported_temporal",
   "reason_text": "The recommendation sets different BP targets tied to distinct treatment phases (before the thrombolysis bolus versus during and for 24 h afterwards), and the DSL has no temporal operators to distinguish these phases. It also requires paired systolic/diastolic thresholds (185/110 and 180/105 mmHg), whereas the schema exposes only a single numeric bp_mmhg variable, so neither target can be expressed faithfully.",
   "source_page": null,
   "source_span": "maintaining BP < 185/110 mmHg before the bolus of intravenous thrombolysis and < 180/105 mmHg during and for 24 h after intravenous thrombolysis",
   "confidence": 0.86,
   "undefined_predicates": [
    "before the bolus of intravenous thrombolysis",
    "during and for 24 h after intravenous thrombolysis",
    "185/110 mmHg",
    "180/105 mmHg"
   ],
   "evidence": [
    "In AIS patients undergoing reperfusion therapy, we recommend maintaining BP < 185/110 mmHg before the bolus of intravenous thrombolysis and < 180/105 mmHg during and for 24 h after intravenous thrombolysis (low-certainty evidence) and/or mechanical thrombectomy (moderate-certainty evidence)."
   ]
  },
