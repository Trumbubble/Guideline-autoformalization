 "rules": [
  {
   "rule_id": "kdigo-3.1",
   "when": {
    "kind": "and",
    "operands": [
     {
      "kind": "cmp",
      "var": "has_diabetes",
      "op": "==",
      "value": true
     },
     {
      "kind": "cmp",
      "var": "acr_mg_g",
      "op": ">=",
      "value": 30
     }
    ]
   },
   "then": {
    "kind": "cmp",
    "var": "on_acei_arb",
    "op": "==",
    "value": true
   },
   "action": "recommend",
   "target": "ACEi or ARB",
   "strength": "1B",
   "source_page": 12,
   "source_span": "Treat with an ACEi or ARB in adults with diabetes and ACR >= 30 mg/g."
  },
  {
   "rule_id": "kdigo-mon",
   "when": {
    "kind": "cmp",
    "var": "on_acei_arb",
    "op": "==",
    "value": true
   },
   "then": {
    "kind": "since",
    "event": "potassium_check",
    "days": 14,
    "inclusive": true
   },
   "action": "monitor",
   "target": "serum potassium",
   "strength": null,
   "source_page": 12,
   "source_span": "Check serum potassium within 14 days of starting therapy."
  }
