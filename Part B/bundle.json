 "rules": [
  {
   "rule_id": "PMC13270348:0110",
   "when": {
    "kind": "and",
    "operands": [
     {
      "kind": "cmp",
      "var": "has_ap",
      "op": "==",
      "value": true
     },
     {
      "kind": "cmp",
      "var": "pca",
      "op": "==",
      "value": true
     }
    ]
   },
   "then": {
    "kind": "cmp",
    "var": "patient_controlled_intravenous_analgesia",
    "op": "==",
    "value": true
   },
   "action": "monitor",
   "target": "patient-controlled intravenous analgesia (PCA) in acute pancreatitis",
   "strength": "suggestion (use with caution)",
   "source_page": null,
   "source_span": "Patient\u2010controlled (intravenous) analgesia is widely used in acute pain management, but we suggest that PCA should be used with caution in the context of AP."
  },
  {
   "rule_id": "PMC13270348:0143",
   "when": {
    "kind": "and",
    "operands": [
     {
      "kind": "cmp",
      "var": "has_expertise_available",
      "op": "==",
      "value": true
     },
     {
      "kind": "cmp",
      "var": "has_may",
      "op": "==",
      "value": true
     }
    ]
   },
   "then": {
    "kind": "and",
    "operands": [
     {
      "kind": "cmp",
      "var": "strict_aseptic_techniques",
      "op": "==",
      "value": true
     },
     {
      "kind": "cmp",
      "var": "has_close_monitoring",
      "op": "==",
      "value": true
     }
    ]
   },
   "action": "recommend",
   "target": "epidural analgesia",
   "strength": "suggest (conditional)",
   "source_page": null,
   "source_span": "We suggest that epidural analgesia may be considered when expertise is available, and strict aseptic techniques and close monitoring are essential."
  }
 ],
 "refusals": [
  {
   "rule_id": "ap-acupuncture-001",
   "reason_code": "vague_predicate",
   "reason_text": "The recommendation conditions effectiveness on 'appropriate acupoints', an unspecified qualifier with no stated criteria, and frames the intervention permissively ('may be considered'), which the deontic obligation cannot faithfully carry. The available variables cannot represent acupoint selection.",
   "source_page": null,
   "source_span": "acupuncture with appropriate acupoints may be effective in relieving abdominal pain ... and may be considered",
   "confidence": 0.72,
   "undefined_predicates": [
    "with appropriate acupoints",
    "may be considered",
    "without significant side effects"
   ],
   "evidence": [
    "Only acupuncture, has_abdominal_pain, and has_ap are available; acupoint appropriateness is unbound.",
    "'may be considered' expresses discretion rather than an obligation."
   ]
  },
  {
   "rule_id": "ap-oral-feeding-pain-001",
   "reason_code": "defeasible",
   "reason_text": "The statement is permissive rather than obligatory: oral feeding 'may be considered', which leaves the decision to clinician discretion and cannot be expressed as a required element of the care plan. It also rests on an unquantified claim that feeding 'does not significantly increase pain', an unstated threshold.",
   "source_page": null,
   "source_span": "oral feeding does not significantly increase pain, and we suggest that oral feeding may be considered",
   "confidence": 0.7,
   "undefined_predicates": [
    "does not significantly increase pain",
    "may be considered"
   ],
   "evidence": [
    "In children with AP, oral feeding does not significantly increase pain, and we suggest that oral feeding may be considered."
   ]
  }
 ]
