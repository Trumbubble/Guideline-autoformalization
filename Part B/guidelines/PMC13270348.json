 "rules": [
  {
   "rule_id": "PMC13270348:0159",
   "when": {
    "kind": "cmp",
    "var": "has_acute_pancreatitis",
    "op": "==",
    "value": true
   },
   "then": {
    "kind": "cmp",
    "var": "acupuncture",
    "op": "==",
    "value": true
   },
   "action": "recommend",
   "target": "acupuncture with appropriate acupoints",
   "strength": "conditional/weak (GRADE); permissive wording",
   "deontic": "permission",
   "source_page": null,
   "source_span": "We suggest that acupuncture with appropriate acupoints may be effective in relieving abdominal pain and reducing the time to oral intake without significant side effects in patients with AP and may be considered."
  },
  {
   "rule_id": "PMC13270348:0087",
   "when": {
    "kind": "and",
    "operands": [
     {
      "kind": "cmp",
      "var": "has_acute_pancreatitis",
      "op": "==",
      "value": true
     },
     {
      "kind": "cmp",
      "var": "has_mild_moderate_pain",
      "op": "==",
      "value": true
     }
    ]
   },
   "then": {
    "kind": "cmp",
    "var": "pain_control",
    "op": "==",
    "value": true
   },
   "action": "recommend",
   "target": "WHO analgesic ladder for pain control",
   "strength": "conditional (suggestion, permissive wording: 'may be sufficient')",
   "deontic": "permission",
   "source_page": null,
   "source_span": "We suggest that for mild to moderate pain, using the WHO ladder may be sufficient for achieving pain control in patients hospitalized with acute pancreatitis."
  }
 ],
 "refusals": [
  {
   "rule_id": "pca-caution-ap",
