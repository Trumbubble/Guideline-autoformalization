   ]
  },
  {
   "rule_id": "epidural-analgesia-ap",
   "reason_code": "not_patient_level",
   "reason_text": "The applicability condition is institutional/service capability ('when expertise is available') rather than a patient-level attribute, and it is not bound to any variable in the schema. The remaining requirements ('strict aseptic techniques', 'close monitoring are essential') are procedural qualifiers on the intervention without stated thresholds, and the offer itself is permissive ('may be considered'), so no faithful when->then encoding is possible with the available variables.",
   "source_page": null,
   "source_span": "We suggest that epidural analgesia may be considered when expertise is available, and strict aseptic techniques and close monitoring are essential.",
