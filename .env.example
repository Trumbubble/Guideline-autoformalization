# Copy to .env and fill in. .env is gitignored (root .gitignore line 151).
#   cp .env.example .env    then edit .env
#
# Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# Note: temperature is REJECTED (400) on opus-5 / sonnet-5 / opus-4-8 / opus-4-7.
# Only claude-sonnet-4-6 and claude-haiku-4-5 still accept it, which matters
# for the sampling-variance probe -- see NOTES.md.
# GF_MODEL=claude-opus-5
